# Skip APIs and use mock data
USE_MOCK_REPOS=false

# Clickhouse query settings
SCAN_LIMIT=150
SCAN_WINDOW_DAYS=7
#SCAN_EVAL_DATE=(YYYY-MM-DD)
SCAN_MIN_GROWTH_RATE=3.0
# Praguri absolute pe trepte de marime (ramura OR peste filtrul de rata).
# ATENTIE la unitati, sunt diferite:
#   SCAN_BIG_REPO_AT      = stele REALE (istoricul din dataset e complet)
#   SCAN_MIN_STARS_*      = evenimente in dataset; datasetul vede ~1,5% din
#                           realitate, deci imparte stelele reale la ~65
#                           (+500 real -> 8, +2000 real -> 30)
# Sterge oricare din cele trei linii ca sa dezactivezi treptele.
SCAN_BIG_REPO_AT=10000
SCAN_MIN_STARS_SMALL=8
SCAN_MIN_STARS_BIG=30

# Release settings
RELEASE_TOP_N=20
# Locuri rezervate pe categorie. Cat timp sunt setate amandoua (plus
# SCAN_BIG_REPO_AT), newsletter-ul are doua sectiuni si RELEASE_TOP_N e ignorat.
RELEASE_TOP_DISCOVERIES=10
RELEASE_TOP_MOVERS=10
RELEASE_TRUNCATE_DESC=0

# Filtering settings
FILTER_MIN_STARS=100
FILTER_RENAMED=false
FILTER_EMPTY_DESC=false
FILTER_FRESH_OWNER=false

# Publish newsletter with Buttondown
BUTTONDOWN_ENABLED=false
BUTTONDOWN_API_KEY=your_buttondown_key_here

# Publish newsletter with Resend
RESEND_ENABLED=false
RESEND_API_KEY=your_resend_key_here
RESEND_FROM="GitHub Trends <onboarding@resend.dev>"
RESEND_TO=your_email@gmail.com

# Publish to GitHub release
GITHUB_RELEASES_ENABLED=true
GITHUB_RELEASES_REPO=RanGrosu/github-famous
GITHUB_TOKEN=your_gh_token_here
# Doar pentru releases (cere drept de scriere). In Actions vine automat.
GITHUB_RELEASES_TOKEN=your_gh_token_with_write_access
